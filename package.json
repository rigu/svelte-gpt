{
	"name": "@rigu/svelte-gpt",
	"version": "1.0.3",
	"description": "Svelte library to render google ADS using google gpt",
	"keywords": [
		"google",
		"googletag",
		"google publisher tags",
		"ADS publisher",
		"tags",
		"svelte",
		"sveltekit"
	],
	"author": {
		"name": "Igor AFTENI",
		"email": "i.afteni@gmail.com"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/rigu/svelte-gpt/issues"
	},
	"homepage": "https://github.com/rigu/svelte-gpt#readme",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublish::only": "npm run package",
		"publish": "npm publish --access public",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^4.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.42.1",
		"@rigu/js-toolkit": "^1.0.3",
		"@sveltejs/adapter-auto": "^3.1.1",
		"@sveltejs/kit": "^2.5.4",
		"@sveltejs/package": "^2.3.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.2",
		"@types/google-publisher-tag": "^1.20240219.0",
		"@typescript-eslint/eslint-plugin": "^7.2.0",
		"@typescript-eslint/parser": "^7.2.0",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.2",
		"publint": "^0.2.7",
		"svelte": "^4.2.12",
		"svelte-check": "^3.6.7",
		"tslib": "^2.6.2",
		"typescript": "^5.4.2",
		"vite": "^5.1.6",
		"vitest": "^1.3.1"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module"
}
